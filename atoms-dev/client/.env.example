# ===========================================
# Vercel 前端环境变量配置示例
# ===========================================
# 复制此文件为 .env.local 并填入你的后端地址
# ===========================================

# 后端服务地址（Vercel 部署时必须设置）
VITE_BACKEND_URL=https://your-server.onrender.com

# 开发环境（本地开发时使用）
# VITE_BACKEND_URL=http://localhost:3001
