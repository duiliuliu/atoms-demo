{
  "name": "atoms-dev-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "MODE=development tsx watch src/index.ts",
    "build": "tsc",
    "start": "MODE=production node dist/index.js",
    "start:dev": "MODE=development node dist/index.js",
    "start:staging": "MODE=staging node dist/index.js",
    "render-build": "npm install && npm run build",
    "render-start": "MODE=production npm start"
  },
  "engines": {
    "node": ">=18.x"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
